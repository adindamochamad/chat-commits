TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Solo hackathon: use the same numeric ID for broadcaster and bot (one Twitch account).
TWITCH_BROADCASTER_ID=
TWITCH_BOT_USER_ID=
# User access token with user:read:chat — token owner must match TWITCH_BOT_USER_ID.
TWITCH_BOT_TOKEN=
# Recording demo: use 15000 for a ~45s wow loop (vote + Codex + approve).
VOTING_WINDOW_MS=15000
HTTP_PORT=3000
# Local overlay/dashboard without Twitch: enables /api/demo/* and skips EventSub.
# SKIP_TWITCH=1
# USE_FIXTURES=1
# DEMO_MODE=1
