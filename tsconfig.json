{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "spike/**/*.ts",
    "server/**/*.ts",
    "game-api/**/*.ts",
    "game-api/**/*.d.ts",
    "overlay/src/**/*.ts",
    "dashboard/src/**/*.ts"
  ]
}
